<!DOCTYPE html>
<html lang="th">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ประวัติออเดอร์</title>
    <link href="https://fonts.googleapis.com/css2?family=Sarabun:wght@400;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/history.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>

<body>

    <div class="container">
        <%- include('header') %>

            <div class="admin-container">
                <div class="page-title-section" style="margin-bottom: 16px;">
                    <h1 class="page-title">ประวัติออเดอร์</h1>
                </div>

                <div class="order-list">
                    <% if (orderHistory && orderHistory.length> 0) { %>
                        <% orderHistory.forEach(order=> { %>
                            <div class="order-card">
                                <div class="order-header">
                                    <span class="order-id">ออเดอร์ #<%= order.orderId %></span>
                                </div>
                                <div class="order-body">
                                    <p class="table-info">
                                        <strong>โต๊ะ:</strong>
                                        <%= 'N/A' %> &nbsp;|&nbsp;
                                            <strong>เวลาชำระเงิน:</strong>
                                            <%= new Date(order.paymentDate).toLocaleString('th-TH', { day: '2-digit' ,
                                                month: 'short' , year: 'numeric' , hour: '2-digit' , minute: '2-digit'
                                                }) %> น.
                                    </p>
                                    <ul class="menu-items">
                                        <% order.items.forEach(item=> { %>
                                            <li>
                                                <%= item.name %> <span>
                                                        <%= item.price %> บาท x <%= item.quantity %>
                                                    </span>
                                            </li>
                                            <% }); %>
                                    </ul>
                                </div>
                                <div class="order-footer">
                                    <span class="total-label">ยอดรวม:</span>
                                    <span class="total-price">
                                        <%= order.totalAmount %> ฿
                                    </span>
                                </div>
                            </div>
                            <% }); %>
                                <% } else { %>
                                    <div style="text-align: center; padding: 50px; color: #888;">
                                        <p>ยังไม่มีประวัติการสั่งซื้อ</p>
                                    </div>
                                    <% } %>
                </div>
            </div>
    </div>
</body>

</html>