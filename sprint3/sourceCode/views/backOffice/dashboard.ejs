<!DOCTYPE html>
<html lang="th">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ยอดขายวันนี้</title>
  <link rel="stylesheet" href="/css/dashboard.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>

<body>
  <div class="container">
    <%- include('header') %>

    <h1 class="page-title">ยอดขายวันนี้</h1>

    <div class="card main-card">
      <p class="label">ขายไปแล้ว</p>
      <p class="value">999</p>
      <p class="unit">ออเดอร์</p>
    </div>

    <div class="card main-card">
      <p class="label">รวมรายได้</p>
      <p class="value">1,000,000</p>
      <p class="unit">บาท</p>
    </div>

    <div class="grid-container">
      <div class="card sub-card">
        <p class="label">เงินสด</p>
        <p class="value-small">999,999</p>
        <p class="unit">บาท</p>
      </div>
      <div class="card sub-card">
        <p class="label">สแกนจ่าย</p>
        <p class="value-small">999,999</p>
        <p class="unit">บาท</p>
      </div>
    </div>
  </div>

</body>

</html>