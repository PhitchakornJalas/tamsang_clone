<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ออเดอร์ของฉัน</title>
    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/order.css">
    <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500;600&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Kanit', sans-serif; }
    </style>
</head>
<body>
    <div class="Mobile" style="background-color: white; display: flex; flex-direction: column;">
        <header class="PromotionPage-header">
            <button class="Back-btn" onclick="window.location.href='/customer'">&#8592;</button>
        </header>
        <hr class="Header-divider">

        <h2 class="Page-title" style="text-align: left; margin-bottom: 20px;">ออเดอร์ที่สั่ง</h2>
   
        <% if (order && order.items && order.items.length > 0) { %>
            <% order.items.forEach(item => { %>
                <div class="Order-Item">
                    <div class="Order-img">
                        </div>
                    <div class="Order-info">
                        <div class="Order-header-row">
                            <div class="Order-title"><%= item.name %></div>
                            <!-- <div class="Order-status-text" style="color: #FF9800;">กำลังปรุง</div> -->
                        </div>
                        <div class="Order-detail-row">
                            <div class="Order-desc">รายละเอียด</div> <div class="Order-price-col">
                                <div class="Order-price"><%= item.price * item.quantity  %> บาท</div>
                                <div class="qty-number-grey"><%= item.quantity %></div>
                            </div>
                        </div>
                    </div>
                </div>
            <% }); %>
        <% } else { %>
            <div style="text-align: center; padding: 50px 0;">
                <p>ออเดอร์ของคุณยังว่างเปล่า</p>
                <a href="/customer" style="color: #ffcc00;">ไปเลือกเมนูอาหาร</a>
            </div>
        <% } %>

        <div class="Order-BottomCheckout">
            <div class="Checkout-Summary">
                <span style="font-size: 18px; font-weight: normal;">รวมราคา</span>
                <span id="order-total-price" style="font-size: 18px; font-weight: normal;"><%= order.totalAmount %> บาท</span>
            </div>
            <button class="Checkout-btn" onclick="document.getElementById('payment-modal-overlay').style.display='flex'">ชำระเงิน</button>
        </div>

        <!-- Payment Modal Overlay -->
        <div id="payment-modal-overlay" class="CustomModal-overlay">
            <div class="CustomModal-box" style="background-color: white; padding-bottom: 20px;">
                <p style="font-size: 18px; font-weight: 500; margin-bottom: 20px;">เลือกช่องทางการชำระเงิน</p>
                <div style="display: flex; flex-direction: column; gap: 10px;">
                    <button class="Payment-choice-btn" onclick="processPayment('cash')">💵 ชำระด้วยเงินสด</button>
                    <button class="Payment-choice-btn" onclick="processPayment('qr')">📱 สแกน QR โค้ด</button>
                    <button class="CustomModal-btn cancel-btn" style="margin-top: 15px; width: 100%;" onclick="document.getElementById('payment-modal-overlay').style.display='none'">ยกเลิก</button>
                </div>
            </div>
        </div>

    </div>

    <script>
        async function processPayment(method) {
            try {
                const response = await fetch('/customer/order/checkout', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ paymentMethod: method })
                });

                const result = await response.json();

                if (result.success) {
                    window.location.href = '/customer';
                } else {
                    alert('เกิดข้อผิดพลาด: ' + result.message);
                }
            } catch (error) {
                console.error("Payment Error:", error);
            }
        }
    </script>
</body>
</html>
