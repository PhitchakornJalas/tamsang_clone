            <div class="Quantity-control">
                <button type="button" id="btn-decrease" class="Quantity-btn">-</button>
                <span id="quantity-display" class="Quantity-display"><%= currentQty %></span>
                <button type="button" id="btn-increase" class="Quantity-btn">+</button>
            </div>
            <div class="Bottom-action">
                <button type="button" class="add-to-cart-btn">เพิ่มลงในตะกร้า</button>
            </div>

            <script>
                // หุ้มโค้ดทั้งหมดไว้ใน window.onload
                window.onload = function() {
                    const addToCartBtn = document.querySelector('.add-to-cart-btn');
                    const btnDecrease = document.getElementById('btn-decrease');
                    const btnIncrease = document.getElementById('btn-increase');
                    const quantityDisplay = document.getElementById('quantity-display');

                    let quantity = parseInt("<%= currentQty %>");
                    const currentMenuId = "<%= item.id %>";

                    if (btnDecrease && btnIncrease && quantityDisplay) {
                        btnDecrease.onclick = function() {
                            if (quantity > 0) {
                                quantity--;
                                quantityDisplay.textContent = quantity;
                            }
                        };
                        btnIncrease.onclick = function() {
                            quantity++;
                            quantityDisplay.textContent = quantity;
                        };
                    }

                    if (addToCartBtn) {
                        function updateButtonUI() {
                            if (quantity === 0) {
                                addToCartBtn.style.backgroundColor = '#f44336';
                                addToCartBtn.textContent = 'ลบออกจากตะกร้า';
                            } else {
                                addToCartBtn.style.backgroundColor = '#fff200';
                                addToCartBtn.textContent = 'เพิ่มลงในตะกร้า';
                            }
                        }

                        updateButtonUI();

                        addToCartBtn.onclick = async function() {
                            let url = '/customer/cart/add';
                            let bodyContent = {
                                menuId: currentMenuId,
                                quantity: quantity,
                                isUpdate: true
                            };

                            if (quantity === 0) {
                                url = '/customer/cart/remove';
                                bodyContent = { menuId: currentMenuId };
                            }

                            try {
                                const response = await fetch(url, {
                                    method: 'POST',
                                    headers: { 'Content-Type': 'application/json' },
                                    body: JSON.stringify(bodyContent)
                                });

                                const contentType = response.headers.get("content-type");
                                if (contentType && contentType.indexOf("application/json") !== -1) {
                                    const result = await response.json();
                                    if (result.success) {
                                        window.location.href = '/customer/cart'; 
                                    } else {
                                        alert('Error: ' + result.message);
                                    }
                                } else {
                                    const errorHtml = await response.text();
                                    console.error("Server Error:", errorHtml);
                                    alert("Server ตอบกลับผิดพลาด (ตรวจสอบ Console)");
                                }
                            } catch (error) {
                                console.error('Fetch Error:', error);
                                alert('ไม่สามารถเชื่อมต่อกับเซิร์ฟเวอร์ได้');
                            }
                        };

                        btnDecrease.addEventListener('click', updateButtonUI);
                        btnIncrease.addEventListener('click', updateButtonUI);
                    }
                };
            </script>
        </form>
    </div>
</body>

