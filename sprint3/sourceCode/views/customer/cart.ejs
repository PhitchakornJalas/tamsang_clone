<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tamsang - Cart</title>
    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/cart.css">
</head>
<body>
    <div class="Mobile">
        <header class="PromotionPage-header">
            <button class="Back-btn" onclick="window.location.href = '/customer'">&#8592;</button>
        </header>

        <h2 class="Page-title" style="text-align: left; margin-top: 0;">ออเดอร์ที่สั่ง</h2>

        <div class="CartList-container" id="cart-container">
            <% if (cartItems && cartItems.length > 0) { %>
                <% cartItems.forEach(item => { %>
                    <a href="/customer/menu/<%= item.menuId %>" style="color: black; text-decoration: none;">
                        <article class="Cart-Item">
                            <div class="Cart-img"></div>
                            <div class="Cart-info">
                                <div class="Cart-title-row">
                                    <span class="Cart-title"><%= item.name %></span>
                                </div>
                                <p class="Cart-desc">รายละเอียด</p>
                                <p class="Cart-option"></p>
                            </div>
                            <div class="Cart-action" style="display: flex; flex-direction: column; justify-content: space-between; align-items: flex-end;">
                                <span class="Cart-price"><%= (item.price * item.quantity) %> บาท</span>
                                <div class="Quantity-control" style="margin: 0; transform: scale(0.85); transform-origin: right;">
                                    <span class="Quantity-display" id="static-qty">x <%= item.quantity %></span>
                                </div>
                            </div>
                        </article>
                    </a>
                <% }); %>
            <% } %>
        </div>

        <div class="Cart-BottomCheckout" id="cart-bottom-checkout">
            <hr class="Header-divider">
            <div class="Checkout-Summary">
                <span>รวมราคา</span>
                <span style="font-weight: bold;" id="total-price-text"><%= totalPrice %> บาท</span>
            </div>
            <button class="Submit-Order-btn" onclick="document.getElementById('custom-modal-overlay').style.display='flex'">ส่งเข้าครัว</button>
        </div>

        <div id="success-overlay" class="Success-overlay">
            <div class="Success-content">
                <div class="Success-img"></div>
                <p>แม่ครัวได้รับออเดอร์แล้ว</p>
            </div>
        </div>

        <div id="custom-modal-overlay" class="CustomModal-overlay">
            <div class="CustomModal-box">
                <p id="custom-modal-text">ต้องการส่งรายการอาหารไปยังห้องครัว?</p>
                <div class="CustomModal-actions">
                    <button class="CustomModal-btn confirm-btn" onclick="confirmCartToOrder()">ยืนยัน</button>
                    <button class="CustomModal-btn cancel-btn" onclick="document.getElementById('custom-modal-overlay').style.display='none'">ยกเลิก</button>
                </div>
            </div>
        </div>

        <script>
            async function confirmCartToOrder() {
                try {
                    const response = await fetch('/customer/order/add', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' }
                    });

                    const result = await response.json();

                    if (result.success) {
                        document.getElementById('custom-modal-overlay').style.display = 'none';
                        document.getElementById('success-overlay').style.display = 'flex';

                        setTimeout(() => {
                            window.location.href = '/customer/order'; 
                        }, 2000);
                    } else {
                        // alert(result.message);
                    }
                } catch (error) {
                    console.error("Error:", error);
                    // alert("การเชื่อมต่อขัดข้อง");
                }
            }
        </script>
    </div>
</body>
</html>